# Server Configuration
SERVER_PORT=5000
DB_URL=your_mongodb_connection_string_here # e.g., mongodb://localhost:27017/petscan_db or mongodb+srv://<user>:<password>@cluster.mongodb.net/petscan_db
JWT_SECRET=your_super_secret_and_long_jwt_string_here_make_it_very_secure

# Cloudinary Configuration (Already used in server/index.js)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer Gmail Configuration
EMAIL_USER=your_gmail_address_for_sending_emails@gmail.com
EMAIL_PASS=your_gmail_app_password_or_oauth_token
